# SOURCE ONLY. Exact existing base; never pull or install dependencies.
# sha256:93dc84393cbaa83f680830c2e53bc7567e1c73a5273f46a36bb72df46fa9f740
FROM escalar-qr-api-eval:16240c5
WORKDIR /proxy
COPY --chown=10001:10001 proxy.py /proxy/fixed-api-proxy.py
USER 10001:10001
HEALTHCHECK --interval=15s --timeout=5s --retries=3 CMD python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8769/api/v1/health',timeout=3); assert r.status==200"
ENTRYPOINT ["python", "/proxy/fixed-api-proxy.py"]
