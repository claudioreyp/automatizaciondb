APP_NAME=Impulsa Restaurant POS API
ENVIRONMENT=development
DATABASE_URL=sqlite+pysqlite:///./impulsa_pos.db
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://panelempresa.vercel.app,https://panelclientes-k8wt.vercel.app

# Supabase Auth / Storage (production)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Independent private secret (32+ characters) for password-reset request HMACs.
AUTH_ADMIN_SECRET=
SUPABASE_OWNER_PROVISION_FUNCTION=provision-pos-owner
INVITE_REDIRECT_URL=http://localhost:5173/invitacion
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Device enrollment: set a reachable POS URL and an independent random server secret.
# Leave disabled until HTTPS/same-site cookies and the additive migration are ready.
POS_PUBLIC_BASE_URL=
DEVICE_AUTH_SECRET=

# Future n8n / service integrations
INTEGRATION_SERVICE_TOKEN=

# Local development only. Leave blank in production.
DEV_AUTH_TOKEN=impulsa-local-dev
LEGACY_PUBLIC_READS_ENABLED=true

# Optional payment evidence extraction
OPENAI_API_KEY=
PAYMENT_VISION_MODEL=gpt-4.1-mini
UPLOAD_DIR=./uploads

# Durable private agent images before processing. Production uses the existing
# private Supabase bucket (impulsa-private); local UPLOAD_DIR needs persistent disk.
# These quotas apply to temporary ingress, never remove payment evidence or staff attachments.
AGENT_MEDIA_MAX_BYTES=8388608
AGENT_MEDIA_MAX_PIXELS=25000000
AGENT_MEDIA_CONVERSATION_BYTES=33554432
AGENT_MEDIA_CONVERSATION_FILES=64
AGENT_MEDIA_BRANCH_BYTES=268435456
AGENT_MEDIA_BRANCH_FILES=1000
AGENT_MEDIA_CLEANUP_BATCH=4

# Google Maps server-side APIs. Never expose this key in the browser bundle.
GOOGLE_MAPS_API_KEY=

# QZ Tray certificate and private signing key (PEM; use \n in one-line environments).
QZ_TRAY_CERTIFICATE=
QZ_TRAY_PRIVATE_KEY=
# Alternatively, use server-only PEM files. Do not configure inline and file together.
# These paths also load from .env.local; never put private keys in CLIENTES/public.
QZ_TRAY_CERTIFICATE_FILE=
QZ_TRAY_PRIVATE_KEY_FILE=
# Missing signing fails closed outside development/dev/test regardless of this flag.
QZ_REQUIRE_SIGNING=false
# Set official ONLY after an issued QZ certificate and matching NEW key are staged.
QZ_TRAY_TRUST_MODE=compatible

# Durable model-token budgets per UTC day. All positive; zero cannot disable them.
# Reserved/uncertain calls remain charged on their original reservation day.
# Server-only settings; never pass these limits or the ledger to the model.
AGENT_USAGE_CONVERSATION_TOKENS=1000000
AGENT_USAGE_SENDER_TOKENS=2000000
AGENT_USAGE_BUSINESS_TOKENS=50000000
AGENT_USAGE_ALERT_PERCENT=80
# JSON by business ID; omitted fields inherit the globals. No runtime consumer edits.
# Example: {"12":{"business_tokens":10000000,"alert_percent":75}}
AGENT_USAGE_BUSINESS_OVERRIDES={}
